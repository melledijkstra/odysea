{
  "extends": "@melledijkstra/config/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "@/svelte/*": ["./src/svelte/*"],
      "@/react/*": ["./src/react/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [".", ".storybook/**/*"],
  "exclude": ["dist", "node_modules", ".turbo", "storybook-static"]
}
