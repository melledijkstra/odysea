{
  "extends": "@melledijkstra/config/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "@/svelte/*": ["./src/svelte/*"],
      "@/react/*": ["./src/react/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [".", ".storybook/**/*", "stories/**/*"],
  "exclude": ["dist", "node_modules", ".turbo"]
}
