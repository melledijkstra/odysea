{
  "name": "@melledijkstra/auth",
  "version": "1.0.4",
  "author": "Melle Dijkstra",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "example": "cd example && tsx --env-file=.env"
  },
  "dependencies": {
    "@badgateway/oauth2-client": "^3.3.1",
    "@melledijkstra/storage": "workspace:*",
    "@melledijkstra/toolbox": "workspace:*"
  },
  "devDependencies": {
    "@melledijkstra/config": "workspace:*",
    "eslint": "catalog:",
    "octokit": "^5.0.5",
    "typescript": "catalog:"
  }
}
