{
  "name": "@melledijkstra/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Personal toolbox containing various tools and utilities",
  "author": "Melle Dijkstra",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest",
    "lint": "eslint .",
    "local:ci": "pnpm build && pnpm lint && pnpm test --run --coverage",
    "clean": "rm -rf .turbo packages/*/.turbo && rm -rf packages/*/dist",
    "publish": "pnpm build && pnpm -r publish --access public",
    "link:all": "pnpm -r exec pnpm link --global",
    "unlink:all": "pnpm -r exec pnpm unlink --global",
    "yalc:publish": "pnpm build && pnpm -r --filter './packages/*' exec yalc publish --push",
    "yalc:push": "pnpm build && pnpm -r --filter './packages/*' exec yalc push"
  },
  "devDependencies": {
    "@eslint/css": "^1.1.0",
    "@eslint/json": "^0.14.0",
    "@stylistic/eslint-plugin": "^5.7.0",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "tsdown": "^0.19.0",
    "tsx": "^4.21.0",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16",
    "yalc": "^1.0.0-pre.53"
  },
  "keywords": [
    "toolbox",
    "utils",
    "utilities"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.10.0"
}
