{
  "name": "odysea",
  "version": "1.0.0",
  "private": true,
  "description": "A personal ecosystem",
  "author": "Melle Dijkstra",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "extension": "pnpm --filter=@odysea/extension run",
    "server": "pnpm --filter=@odysea/server run",
    "serverless": "pnpm --filter=@odysea/serverless run",
    "packages": "pnpm --filter=@melledijkstra/* run",
    "cli": "pnpm --filter=@odysea/cli run",
    "storybook:build": "pnpm --filter=@odysea/extension run storybook:build",
    "local:ci": "pnpm build && pnpm lint && CI=true pnpm test && pnpm test:e2e",
    "cleanup": "rm -rf .turbo node_modules && rm -fr apps/*/node_modules && pnpm cache delete"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "svelte-eslint-parser": "^1.8.0",
    "tsdown": "^0.22.5",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/melledijkstra/odysea.git"
  },
  "bugs": {
    "url": "https://github.com/melledijkstra/odysea/issues"
  },
  "homepage": "https://github.com/melledijkstra/odysea#readme",
  "packageManager": "pnpm@11.11.0"
}
