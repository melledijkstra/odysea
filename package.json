{
  "name": "odysea",
  "version": "1.0.0",
  "private": true,
  "description": "A personal ecosystem",
  "author": "Melle Dijkstra",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "format:root": "turbo run format",
    "typecheck": "turbo run typecheck",
    "extension": "pnpm --filter=@odysea/extension run",
    "server": "pnpm --filter=@odysea/server run",
    "serverless": "pnpm --filter=@odysea/serverless run",
    "packages": "pnpm --filter=@melledijkstra/* run",
    "cli": "pnpm --filter=@odysea/cli run",
    "storybook:build": "pnpm --filter=@odysea/extension run storybook:build",
    "local:ci": "CI=true turbo run build format lint typecheck test test:e2e",
    "cleanup": "rm -rf .turbo node_modules && rm -fr apps/*/node_modules && pnpm cache delete"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@melledijkstra/config": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "tsdown": "^0.22.9",
    "turbo": "^2.10.5",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/melledijkstra/odysea.git"
  },
  "bugs": {
    "url": "https://github.com/melledijkstra/odysea/issues"
  },
  "homepage": "https://github.com/melledijkstra/odysea#readme",
  "packageManager": "pnpm@11.11.0"
}
