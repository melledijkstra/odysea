{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["PORT", "DEV", "MODE", "CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".dist/**",
        "build/**",
        ".next/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "start": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["^start"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "^test:e2e"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "storybook:build": {
      "dependsOn": ["^build", "^storybook:build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
