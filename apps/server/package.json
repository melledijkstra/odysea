{
  "name": "@odysea/server",
  "version": "0.0.1",
  "description": "Server for the Odysea ecosystem",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate --knexfile ./knexfile.ts migrate:latest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "sqlite3": "^6.0.1",
    "tsx": "catalog:",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@melledijkstra/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "eslint": "catalog:"
  }
}
