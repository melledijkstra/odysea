{
  "name": "looper",
  "version": "1.0.0",
  "description": "Automation tool for running workflows on a schedule",
  "author": "Melle Dijkstra",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx index.ts",
    "dev": "tsx watch index.ts --port 5051",
    "bootstrap": "pm2 start ./ecosystem.config.cjs",
    "webhook": "curl -X POST -d '{\"workflowId\":\"simple-webhook\"}' -H 'Content-Type: application/json' http://localhost:5050/webhook"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@melledijkstra/auth": "workspace:*",
    "@melledijkstra/storage": "workspace:*",
    "@melledijkstra/toolbox": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "chokidar": "^3.6.0",
    "cron-parser": "^5.7.0",
    "cron-translate": "^2.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "js-yaml": "^4.3.1",
    "node-cron": "^4.6.0",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@melledijkstra/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "@types/node-notifier": "^8.0.5",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
